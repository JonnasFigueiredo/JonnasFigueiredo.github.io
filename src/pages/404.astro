---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" noindex>
  <div class="prose">
    <p class="eyebrow">Erro 404</p>
    <h1>Essa página não existe</h1>
    <p class="lead">
      O link pode estar quebrado ou o conteúdo pode ter mudado de lugar.
    </p>
    <p>
      Veja os <a href="/projetos">projetos</a>, saiba mais <a href="/sobre">sobre mim</a> ou
      volte para a <a href="/">página inicial</a>.
    </p>
  </div>
</Base>
