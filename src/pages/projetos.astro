---
import Base from '../layouts/Base.astro';
import ProjetoCard from '../components/ProjetoCard.astro';
import { projetos, grupos } from '../data/projetos';
---

<Base
  title="Projetos"
  description="Projetos open source de Jonnas Figueiredo: frameworks de automação de testes, avaliação de LLMs, servidores MCP e experimentos."
>
  <header class="topo prose">
    <p class="eyebrow">Projetos</p>
    <h1>O que eu construo</h1>
    <p class="lead">
      Quase tudo aqui nasceu de um problema real de qualidade que eu queria resolver direito.
      Os nomes vêm da mitologia grega — cada um diz algo sobre o que a ferramenta faz.
    </p>
  </header>

  {
    grupos.map((grupo) => {
      const doGrupo = projetos.filter((p) => p.grupo === grupo.id);
      return (
        <section class="section">
          <h2>{grupo.titulo}</h2>
          <p class="dim resumo">{grupo.resumo}</p>
          <div class="grid">
            {doGrupo.map((projeto) => (
              <ProjetoCard projeto={projeto} />
            ))}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .topo h1 {
    margin-bottom: 0.5rem;
  }
  .resumo {
    margin: -0.3rem 0 1.2rem;
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
</style>
