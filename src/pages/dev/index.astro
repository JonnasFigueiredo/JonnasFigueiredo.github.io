---
import Dev from '../../layouts/Dev.astro';
import { site } from '../../config';
import { devGroups, devProjects } from '../../data/devPortfolio';

const description = 'Projetos de desenvolvimento de Jonnas Figueiredo: aplicações full stack com Java, Spring Boot e React, além de APIs e sistemas backend.';
---

<Dev title="Projetos de desenvolvimento" description={description}>
  <section class="hero" aria-labelledby="dev-title">
    <div>
      <p class="eyebrow">Jonnas Figueiredo / Desenvolvimento</p>
      <h1 id="dev-title">Meu portfólio.</h1>
      <p class="intro">Desenvolvo aplicações full stack com Java, Spring Boot e React. Minha experiência em qualidade de software também faz parte desse trabalho.</p>
      <div class="hero-actions">
        <a href="#projetos">Explorar projetos <span aria-hidden="true">↓</span></a>
        <a href={'mailto:' + site.email}>Entrar em contato <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Resumo do portfólio">
      <div><strong>05</strong><br /><span>Projetos selecionados</span></div>
      <p>De produtos com interface a serviços de dados, integração e processamento.</p>
    </aside>
  </section>

  <section id="projetos" aria-labelledby="projects-title">
    <div class="section-line">
      <h2 id="projects-title">Projetos selecionados</h2>
      <p>Uma seleção do que construí, com código e contexto técnico.</p>
    </div>
    {devGroups.map(group => {
      const projects = devProjects.filter(project => project.category === group.title);
      return <div class="group">
        <div class="group-title"><h3>{group.title}</h3><p>{group.description}</p></div>
        <div class="project-list">
          {projects.map(project => {
            const index = devProjects.indexOf(project) + 1;
            return <a class="project-row" href={`/dev/projetos/${project.slug}/`} aria-label={`Conhecer o projeto ${project.name}`}>
              <span class="number">{String(index).padStart(2, '0')}</span>
              <strong class="name">{project.name}</strong>
              <span class="line">{project.line}</span>
              <span class="meta"><span>{project.stack[0]}</span><span>{project.stack[1]}</span><span>{project.status}</span></span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>;
          })}
        </div>
      </div>;
    })}
  </section>

  <section id="sobre" class="about-section" aria-labelledby="about-title">
    <div><p class="eyebrow">Sobre o trabalho</p><h2 id="about-title">Do domínio à interface.</h2></div>
    <div>
      <p>Meu trabalho começa pelo problema: quais regras precisam ser preservadas, quem vai usar o sistema e como saber se ele continua correto. É essa pergunta que liga arquitetura, experiência de uso e testes.</p>
      <p>Atuo em engenharia de qualidade e aplico essa bagagem ao desenvolver APIs, interfaces e integrações. Os projetos desta página mostram os dois lados: software que funciona para quem usa e código que pode ser examinado por quem desenvolve.</p>
      <a class="text-link" href="/sobre">Conhecer minha trajetória <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="contato" class="contact-section" aria-labelledby="contact-title">
    <div><p class="eyebrow">Contato</p><h2 id="contact-title">Vamos construir<br />algo útil?</h2></div>
    <a class="text-link" href={'mailto:' + site.email}>{site.email} <span aria-hidden="true">↗</span></a>
  </section>
</Dev>
