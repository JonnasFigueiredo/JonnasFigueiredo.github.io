---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatarData, formatarDataISO } from '../../utils/data';
import { site } from '../../config';

export const getStaticPaths: GetStaticPaths = async () => {
  const artigos = await getCollection('artigos', ({ data }) => !data.draft);
  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: { artigo },
  }));
};

type Props = { artigo: CollectionEntry<'artigos'> };

const { artigo } = Astro.props;
const { Content } = await render(artigo);

const url = new URL(`/artigos/${artigo.id}`, site.url).href;

// BlogPosting explícito: é o que habilita o artigo a aparecer como resultado
// rico e o que amarra a autoria à entidade Person do site.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: artigo.data.title,
  description: artigo.data.description,
  datePublished: artigo.data.pubDate.toISOString(),
  dateModified: (artigo.data.updatedDate ?? artigo.data.pubDate).toISOString(),
  inLanguage: site.locale,
  keywords: artigo.data.tags,
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<Base
  title={artigo.data.title}
  description={artigo.data.description}
  ogType="article"
  jsonld={jsonld}
>
  <article class="prose">
    <header>
      <p class="eyebrow">Artigo</p>
      <h1>{artigo.data.title}</h1>
      <p class="meta">
        <time datetime={formatarDataISO(artigo.data.pubDate)}>
          {formatarData(artigo.data.pubDate)}
        </time>
        {
          artigo.data.updatedDate && (
            <>
              {' · atualizado em '}
              <time datetime={formatarDataISO(artigo.data.updatedDate)}>
                {formatarData(artigo.data.updatedDate)}
              </time>
            </>
          )
        }
      </p>
      {
        artigo.data.tags.length > 0 && (
          <ul class="stack-list">
            {artigo.data.tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="corpo">
      <Content />
    </div>

    <footer>
      <a href="/artigos">← Todos os artigos</a>
    </footer>
  </article>
</Base>

<style>
  header {
    margin-bottom: 2.5rem;
  }
  h1 {
    margin-bottom: 0.5rem;
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
  }
  .corpo :global(h2) {
    margin-top: 2.5rem;
  }
  .corpo :global(h3) {
    margin-top: 2rem;
  }
  .corpo :global(ul),
  .corpo :global(ol) {
    padding-left: 1.3rem;
  }
  .corpo :global(li) {
    margin-bottom: 0.4rem;
  }
  footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
</style>
