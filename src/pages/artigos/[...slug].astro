---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Study from '../../layouts/Study.astro';
import ProteuNote from '../../components/ProteuNote.astro';
import { site } from '../../config';
import { techniqueOrder } from '../../data/learning';
export const getStaticPaths: GetStaticPaths = async () => (await getCollection('artigos', ({data})=>!data.draft)).map(artigo=>({params:{slug:artigo.id},props:{artigo}}));
type Props = { artigo: CollectionEntry<'artigos'> };
const { artigo } = Astro.props;
if(artigo.id==='guia-para-investigar-regras-de-negocio') return Astro.redirect('/guia',301);
const { Content, headings } = await render(artigo);
const words = artigo.body?.split(/\s+/).length ?? 0;
const group = artigo.data.section==='caso'?'Estudos de caso':artigo.data.section==='leitura'?'Leituras':artigo.data.section==='guia'?'Guia':'Técnicas';
const jsonld = {
  '@type':'BlogPosting', headline:artigo.data.title, description:artigo.data.description,
  datePublished:artigo.data.pubDate.toISOString(),
  dateModified:(artigo.data.updatedDate??artigo.data.pubDate).toISOString(), inLanguage:site.locale, wordCount:words,
  author:artigo.data.kind==='traducao'?{'@type':'Organization',name:artigo.data.originalAuthor}:{'@id':site.url+'/#person'},
  ...(artigo.data.kind==='traducao'?{translator:{'@id':site.url+'/#person'},isBasedOn:artigo.data.originalUrl}:{}),
  publisher:{'@id':site.url+'/#person'}, mainEntityOfPage:{'@type':'WebPage','@id':site.url+'/artigos/'+artigo.id},
};
const index = techniqueOrder.indexOf(artigo.id);
const all = await getCollection('artigos');
const prev = index>=0 ? all.find(a=>a.id===techniqueOrder[index-1]) : undefined;
const next = index>=0 ? all.find(a=>a.id===techniqueOrder[index+1]) : undefined;
---
<Study title={artigo.data.title} description={artigo.data.description} category={artigo.data.category} minutes={Math.max(1,Math.ceil(words/200))} headings={headings} jsonld={jsonld} group={group} whenUse={artigo.data.whenUse} articleId={artigo.id}>
  <Content />
  <div slot="after">
    {artigo.id==='valores-limite' && <ProteuNote placement="limites" />}
    {artigo.id==='relatar-problemas' && <ProteuNote placement="relato" />}
    <div class="apply"><p>Leve esta prática para uma decisão da sua tarefa.</p><a class="btn primary" href="/ferramenta">Aplicar na ferramenta <span aria-hidden="true">→</span></a></div>
    <nav class="pager" aria-label="Continuar o estudo">
      <a href={prev?'/artigos/'+prev.id:'/guia'}><span class="label">← Anterior</span><b>{prev?.data.title??'Voltar ao guia'}</b></a>
      <a href={next?'/artigos/'+next.id:'/ferramenta'}><span class="label">Próximo →</span><b>{next?.data.title??'Aplicar na ferramenta'}</b></a>
    </nav>
  </div>
</Study>
<style>
  .apply { display:flex; justify-content:space-between; align-items:center; gap:16px 24px; flex-wrap:wrap; border-top:1px solid var(--rule); padding-top:28px; margin-top:56px; }
  .apply p { margin:0; color:var(--ink-2); font-style:italic; }
  .pager { display:grid; grid-template-columns:1fr 1fr; border-top:1px solid var(--ink); margin-top:48px; }
  .pager a { padding:18px 0; text-decoration:none; }
  .pager a + a { text-align:right; border-left:1px solid var(--rule); padding-left:20px; }
  .pager .label { display:block; margin-bottom:4px; }
  .pager b { font:500 1.2rem/1.3 var(--serif); }
  .pager a:hover b { text-decoration:underline; text-decoration-color:var(--rule); text-underline-offset:4px; }
  @media(max-width:560px) { .pager { grid-template-columns:1fr; } .pager a + a { text-align:left; border-left:0; padding-left:0; border-top:1px solid var(--rule); } }
</style>
