---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListaArtigos from '../../components/ListaArtigos.astro';
import { site } from '../../config';

const artigos = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Sem artigos ainda: nada de Blog schema vazio, e a página fica fora do índice
// para não entrar no Google como conteúdo raso. Volta sozinho no primeiro post.
const vazio = artigos.length === 0;

const jsonld = {
  '@type': 'Blog',
  '@id': `${site.url}/artigos#blog`,
  name: `Artigos de ${site.name}`,
  description:
    'Artigos sobre qualidade de software, automação de testes e avaliação de sistemas de IA.',
  url: new URL('/artigos', site.url).href,
  inLanguage: site.locale,
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
  blogPost: artigos.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.data.title,
    description: a.data.description,
    datePublished: a.data.pubDate.toISOString(),
    url: new URL(`/artigos/${a.id}`, site.url).href,
  })),
};
---

<Base
  title="Artigos sobre qualidade de software e automação de testes"
  description="Artigos de Jonnas Figueiredo sobre automação de testes, arquitetura de suítes, testes flaky, Selenium, Appium, Playwright e avaliação de sistemas de IA."
  jsonld={vazio ? undefined : jsonld}
  noindex={vazio}
  breadcrumb={[{ nome: 'Artigos', href: '/artigos' }]}
>
  <header class="topo prose">
    <p class="eyebrow">Artigos</p>
    <h1>Artigos sobre qualidade de software</h1>
    <p class="lead">
      Notas sobre automação de testes, arquitetura de suítes e como testar sistemas que não dão
      a mesma resposta duas vezes. Publico em português porque é onde falta material bom.
      {!vazio && (
        <>
          <a href="/rss.xml">Assine o RSS</a>.
        </>
      )}
    </p>
  </header>

  <div class="section">
    <ListaArtigos artigos={artigos} />
  </div>
</Base>

<style>
  .topo h1 {
    margin-bottom: 0.5rem;
  }
</style>
