---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListaArtigos from '../../components/ListaArtigos.astro';

const artigos = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Artigos"
  description="Artigos de Jonnas Figueiredo sobre qualidade de software, automação de testes, Selenium, Appium e avaliação de sistemas de IA."
>
  <header class="topo prose">
    <p class="eyebrow">Artigos</p>
    <h1>Escrevendo sobre qualidade</h1>
    <p class="lead">
      Notas sobre automação de testes, arquitetura de suítes e como testar sistemas que não
      dão a mesma resposta duas vezes. <a href="/rss.xml">Assine o RSS</a>.
    </p>
  </header>

  <div class="section">
    <ListaArtigos artigos={artigos} />
  </div>
</Base>

<style>
  .topo h1 {
    margin-bottom: 0.5rem;
  }
</style>
