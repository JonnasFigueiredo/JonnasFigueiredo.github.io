---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjetoCard from '../components/ProjetoCard.astro';
import ListaArtigos from '../components/ListaArtigos.astro';
import { projetos } from '../data/projetos';
import { site } from '../config';

const destaques = projetos.slice(0, 3);

const artigos = (await getCollection('artigos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base
  title="Jonnas Figueiredo | QA Automation Engineer e SDET"
  appendName={false}
  description="Jonnas Figueiredo, engenheiro de automação de testes (QA/SDET) com mais de 3 anos de experiência em Java, Selenium, Appium e Playwright. Projetos open source e artigos sobre qualidade de software."
>
  <section class="hero">
    <p class="eyebrow">{site.jobTitle}</p>
    <h1>Jonnas Figueiredo</h1>
    <p class="lead">
      Sou engenheiro de automação de testes com mais de três anos de experiência. Construo a
      automação que dá segurança para entregar sem regressão em aplicações web, mobile, API e
      backend, trabalhando principalmente com Java, Selenium, Appium e Playwright.
    </p>
    <p>
      O que me move não é a ferramenta, e sim entender o negócio por trás do sistema. No fim, é
      isso que faz um teste valer alguma coisa. Ultimamente venho levando o mesmo rigor de
      engenharia para sistemas de IA, que são não-determinísticos por natureza. Também faço
      palestras sobre qualidade e automação de testes.
    </p>
    <ul class="links">
      <li><a href="/projetos">Ver projetos</a></li>
      <li><a href="/artigos">Ler artigos</a></li>
      <li><a href="/sobre">Sobre mim</a></li>
      <li><a href={site.profiles.github} rel="me noopener">GitHub</a></li>
      <li><a href={site.profiles.linkedin} rel="me noopener">LinkedIn</a></li>
    </ul>
  </section>

  <section class="section">
    <h2>Projetos em destaque <a href="/projetos">todos os projetos</a></h2>
    <div class="grid">
      {destaques.map((projeto) => <ProjetoCard projeto={projeto} compacto />)}
    </div>
  </section>

  <section class="section">
    <h2>Artigos recentes <a href="/artigos">todos os artigos</a></h2>
    <ListaArtigos artigos={artigos} />
  </section>
</Base>

<style>
  .hero {
    max-width: var(--measure);
  }
  .hero h1 {
    margin-bottom: 0.6rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
</style>
