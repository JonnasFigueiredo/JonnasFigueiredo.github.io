---
import Base from '../layouts/Base.astro';
import ProteuNote from '../components/ProteuNote.astro';
import { steps, readings } from '../data/learning';
const picks = ['spec-by-example','ctfl','learning'].map(id=>readings.find(r=>r.id===id)).filter(r=>r!==undefined);
---
<Base title="Como dominar qualquer regra de negócio" description="Um ponto de partida para QAs em um novo domínio. Guia prático, técnicas, leituras e uma ferramenta de investigação.">
  <section class="hero">
    <div>
      <p class="eyebrow">Guia prático para QAs</p>
      <h1>Como dominar qualquer <span class="circ">regra<svg viewBox="0 0 200 90" preserveAspectRatio="none" aria-hidden="true"><path d="M104 8 C52 4 10 18 8 44 C6 72 60 86 112 82 C166 78 196 62 192 40 C188 16 150 6 96 10"/></svg></span> de negócio</h1>
      <p class="lead">Entenda o que muda uma decisão, converse com quem conhece o processo e transforme a regra em testes.</p>
      <a class="start" href="/guia">Começar pelo guia <span aria-hidden="true">→</span></a>
    </div>

    <article class="note" aria-label="Exemplo fictício de nota de investigação">
      <header><b>Nota de investigação</b><span class="label">Exemplo fictício</span></header>
      <dl>
        <div class="f q"><dt>Pergunta</dt><dd>Quando o cancelamento aceito deve impedir a expedição?</dd></div>
        <div class="f a"><dt>Resposta</dt><dd><span class="tag b">Confirmada</span>Antes da entrega registrada à transportadora, bloqueia a saída. Depois, vira devolução.</dd></div>
        <div class="f e"><dt>Exemplo</dt><dd>Pedido pago, etiqueta impressa, caixa na loja. Cancela e tenta a saída. <span class="mono">Esperado: bloquear</span></dd></div>
        <div class="f s"><dt>Fonte</dt><dd>Responsável pela expedição, confirmado em <span class="mono">12/09</span>.</dd></div>
        <div class="f p"><dt>Pendente</dt><dd><span class="tag r">Em aberto</span>E se cancelar durante a coleta?</dd></div>
      </dl>
    </article>
  </section>

  <section class="doors" aria-labelledby="comecar">
    <h2 id="comecar">Por onde começar</h2>
    <a class="door" href="/guia"><span class="when-text">Caí num projeto novo</span><span class="what"><b>O guia</b><span>Recortar a dúvida, investigar, conferir e registrar.</span></span><span class="go" aria-hidden="true">→</span></a>
    <a class="door" href="/artigos/comunicacao-no-trabalho-do-qa"><span class="when-text">Preciso conversar com alguém</span><span class="what"><b>Com quem conversar</b><span>Suporte, operação, PO e desenvolvimento.</span></span><span class="go" aria-hidden="true">→</span></a>
    <a class="door" href="/ferramenta"><span class="when-text">Quero aplicar agora</span><span class="what"><b>Ferramenta</b><span>Monte a nota da sua tarefa, uma decisão por vez.</span></span><span class="go" aria-hidden="true">→</span></a>
  </section>

  <section class="steps" aria-labelledby="caminho">
    <h2 id="caminho">O caminho</h2>
    <ol>{steps.map((step,i)=><li><a href={'/guia#'+step.id}><span class="n">0{i+1}</span><h3>{step.title}</h3><p>{step.description}</p></a></li>)}</ol>
  </section>

  <ProteuNote />

  <section class="reads" aria-labelledby="ler">
    <div class="reads-head"><h2 id="ler">Para ler depois</h2><a href="/leituras">Todas as leituras →</a></div>
    <div class="row">{picks.map(book=><a class="book" href={'/leituras#'+book.id}><span class="label">{book.topic}</span><h3>{book.title}</h3>{'author' in book && <div class="by">{book.author}</div>}<p>{book.why}</p></a>)}</div>
  </section>
</Base>
<style>
  .hero { display:grid; grid-template-columns:1.1fr .9fr; gap:64px; padding:72px 0 64px; align-items:start; }
  .hero h1 { font:500 clamp(2.6rem,5.4vw,4.25rem)/1.04 var(--serif); letter-spacing:-.02em; margin:14px 0 22px; }
  .circ { position:relative; white-space:nowrap; }
  .circ svg { position:absolute; left:-6%; top:-14%; width:112%; height:128%; pointer-events:none; overflow:visible; }
  .circ path { fill:none; stroke:var(--r); stroke-width:2.4; stroke-linecap:round; stroke-dasharray:520; stroke-dashoffset:520; animation:draw 1.1s .3s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset:0; } }
  @media (prefers-reduced-motion:reduce) { .circ path { animation:none; stroke-dashoffset:0; } }
  .hero .lead { font-size:1.45rem; max-width:34ch; margin:0 0 30px; }
  .start { font:500 15px var(--sans); display:inline-flex; gap:10px; align-items:center; border-bottom:2px solid var(--ink); padding-bottom:3px; text-decoration:none; }

  .note { background:var(--sheet); border:1px solid var(--rule); border-radius:3px; box-shadow:0 1px 0 var(--rule-2),0 2px 0 var(--rule); margin:0; }
  .note header { display:flex; justify-content:space-between; align-items:baseline; padding:14px 20px; border-bottom:1px solid var(--rule); }
  .note header b { font:600 14px var(--sans); }
  .note dl { margin:0; }
  .note .f { display:grid; grid-template-columns:112px 1fr; border-bottom:1px solid var(--rule-2); }
  .note .f:last-child { border-bottom:0; }
  .note dt { padding:12px 0 12px 20px; font:600 11px/1.5 var(--sans); letter-spacing:.08em; text-transform:uppercase; border-left:4px solid transparent; }
  .note dd { margin:0; padding:10px 20px 10px 8px; font-size:16px; line-height:1.55; }
  .f.q dt { border-color:var(--y); color:var(--y); } .f.a dt { border-color:var(--b); color:var(--b); } .f.e dt { border-color:var(--g); color:var(--g); } .f.s dt { border-color:var(--ink-3); color:var(--ink-2); } .f.p dt { border-color:var(--r); color:var(--r); }
  .tag { margin-right:6px; vertical-align:2px; }
  .tag.b { background:var(--b-bg); color:var(--b); } .tag.r { background:var(--r-bg); color:var(--r); }

  .doors,.steps,.reads { border-top:1px solid var(--ink); padding:0 0 64px; }
  .doors h2,.steps h2,.reads h2 { font:500 1.9rem/1.2 var(--serif); letter-spacing:-.01em; margin:28px 0 8px; }
  .door { display:grid; grid-template-columns:260px 1fr auto; gap:32px; align-items:baseline; padding:22px 0; border-bottom:1px solid var(--rule); text-decoration:none; }
  .door:hover .go { transform:translateX(4px); }
  .door:hover b { text-decoration:underline; text-decoration-color:var(--rule); text-underline-offset:4px; }
  .when-text { font:italic 1.3rem/1.35 var(--serif); }
  .what b { display:block; font:600 16px var(--sans); margin-bottom:2px; }
  .what span { color:var(--ink-2); font-size:1rem; }
  .go { font:500 20px var(--sans); transition:transform .15s; }

  .steps ol { list-style:none; margin:24px 0 0; padding:0; display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--rule); }
  .steps li { border-right:1px solid var(--rule-2); padding-right:24px; margin-right:24px; }
  .steps li:last-child { border-right:0; margin-right:0; padding-right:0; }
  .steps a { display:block; padding-top:22px; text-decoration:none; }
  .steps a:hover h3 { text-decoration:underline; text-decoration-color:var(--rule); text-underline-offset:4px; }
  .n { font:500 13px var(--mono); color:var(--ink-3); }
  .steps h3 { font:600 18px var(--sans); margin:8px 0 6px; }
  .steps p { margin:0; color:var(--ink-2); font-size:1rem; line-height:1.55; }

  .reads { padding-bottom:40px; }
  .reads-head { display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap; }
  .reads-head a { font:500 14px var(--sans); }
  .row { display:grid; grid-template-columns:repeat(3,1fr); gap:40px; margin-top:24px; }
  .book { border-top:3px solid var(--ink); padding-top:14px; text-decoration:none; }
  .book h3 { font:500 1.4rem/1.25 var(--serif); margin:6px 0 2px; }
  .book:hover h3 { text-decoration:underline; text-decoration-color:var(--rule); text-underline-offset:4px; }
  .by { font:14px var(--sans); color:var(--ink-3); margin-bottom:10px; }
  .book p { margin:0; font-size:1rem; color:var(--ink-2); line-height:1.55; }

  @media(max-width:900px) { .hero { grid-template-columns:1fr; gap:40px; padding:44px 0 48px; } .steps ol { grid-template-columns:1fr 1fr; row-gap:8px; } .steps li:nth-child(2) { border-right:0; margin-right:0; padding-right:0; } .row { grid-template-columns:1fr; gap:28px; } }
  @media(max-width:560px) {
    .hero .lead { font-size:1.2rem; }
    .note .f { grid-template-columns:1fr; border-left:4px solid transparent; }
    .note dt { padding:10px 16px 0; border-left:0; }
    .note dd { padding:2px 16px 12px; }
    .f.q { border-left-color:var(--y); } .f.a { border-left-color:var(--b); } .f.e { border-left-color:var(--g); } .f.s { border-left-color:var(--ink-3); } .f.p { border-left-color:var(--r); }
    .door { grid-template-columns:1fr auto; gap:6px 16px; } .when-text { grid-column:1/-1; }
    .steps ol { grid-template-columns:1fr; } .steps li { border-right:0; margin-right:0; padding-right:0; border-bottom:1px solid var(--rule-2); padding-bottom:18px; }
  }
</style>
