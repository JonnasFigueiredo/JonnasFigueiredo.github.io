---
import { site } from '../config';
---
<footer class="site-footer"><div class="wrap footer-row">
  <p>© {new Date().getFullYear()} {site.name}</p>
  <nav aria-label="Rodapé"><a href="/sobre#o-que-eu-construo">Projetos</a><a href={site.profiles.github} rel="me noopener">GitHub</a><a href={site.profiles.linkedin} rel="me noopener">LinkedIn</a><a href="/privacidade">Privacidade</a></nav>
  <button type="button" id="analytics-preferences" hidden>Preferências de estatísticas</button>
</div></footer>
<style>
  .site-footer { border-top:1px solid var(--ink); margin-top:40px; padding:28px 0 36px; color:var(--ink-2); font:14px/1.5 var(--sans); }
  .footer-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:18px; }
  p { margin:0; } nav { display:flex; flex-wrap:wrap; gap:20px; } a { color:var(--ink-2); text-decoration:none; } a:hover { color:var(--ink); }
  button { background:none; border:0; padding:0; color:var(--ink-2); font:inherit; text-decoration:underline; }
</style>
