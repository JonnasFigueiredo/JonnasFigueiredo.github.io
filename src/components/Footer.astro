---
import { site } from '../config';

const ano = new Date().getFullYear();
const links = [
  { href: site.profiles.github, label: 'GitHub' },
  { href: site.profiles.linkedin, label: 'LinkedIn' },
  { href: site.profiles.youtube, label: 'YouTube' },
  { href: `mailto:${site.email}`, label: 'E-mail' },
];
---

<footer>
  <div class="wrap inner">
    <p class="dim">© {ano} {site.name}</p>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
