---
import { nav } from '../config';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) => href === '/guia' ? path.startsWith('/guia') : href === '/leituras' ? path.startsWith('/leituras') || path.startsWith('/artigos/bibliografia-comentada') : href === '/tecnicas' ? path.startsWith('/tecnicas') || (path.startsWith('/artigos') && !path.startsWith('/artigos/bibliografia-comentada')) : path.startsWith(href);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">Como dominar qualquer regra de negócio<small>Jonnas Figueiredo</small></a>
    <nav aria-label="Navegação principal">{nav.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
    <button id="theme-toggle" class="icon-button" type="button" aria-label="Ativar tema escuro" title="Ativar tema escuro" aria-pressed="false" hidden><Icon name="SunMoon" /></button>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (!button) return;
    button.setAttribute('aria-pressed', String(dark));
    button.setAttribute('aria-label', dark ? 'Ativar tema claro' : 'Ativar tema escuro');
    button.title = button.getAttribute('aria-label')!;
  };
  if (button) {
    button.hidden = false; sync();
    button.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('jonnas-theme', theme); } catch { /* Theme works without storage. */ }
      sync();
    });
  }
</script>
<style>
  .site-header { position:sticky; top:0; z-index:20; background:var(--paper); border-bottom:1px solid var(--rule); }
  .bar { display:flex; align-items:center; gap:32px; min-height:64px; }
  .brand { font:600 15px/1.25 var(--sans); text-decoration:none; color:var(--ink); }
  .brand small { display:block; font-weight:400; font-size:12px; color:var(--ink-3); }
  nav { display:flex; gap:24px; margin-left:auto; font:500 14px var(--sans); }
  nav a { color:var(--ink-2); text-decoration:none; padding:6px 0; }
  nav a:hover { color:var(--ink); }
  nav a[aria-current=page] { color:var(--ink); box-shadow:inset 0 -2px 0 var(--ink); }
  @media(max-width:1050px) { .bar { flex-wrap:wrap; gap:6px 12px; padding-top:12px; padding-bottom:6px; } .brand { flex:1; min-width:0; margin-right:auto; } nav { order:3; width:100%; margin:0; flex-wrap:wrap; gap:0 6px; justify-content:space-between; font-size:13px; } nav a { padding:12px 0; } .icon-button { width:36px; height:36px; flex-shrink:0; } }
</style>
