---
import type { Projeto } from '../data/projetos';

interface Props {
  projeto: Projeto;
  /** Na home mostramos a versão curta, sem a origem do nome nem a descrição longa. */
  compacto?: boolean;
}

const { projeto, compacto = false } = Astro.props;
---

<article class="card">
  <h3>
    <a href={projeto.repo} rel="noopener" title={`Repositório de ${projeto.nome} no GitHub`}>
      {projeto.nome}
    </a>
  </h3>
  {!compacto && projeto.origem && <p class="origem">{projeto.origem}</p>}
  <p class="desc">{compacto ? projeto.resumo : projeto.descricao}</p>
  <ul class="stack-list">
    {projeto.stack.map((s) => <li class="tag">{s}</li>)}
  </ul>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.25rem 1.35rem;
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
  }
  h3 {
    margin: 0 0 0.15rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .origem {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--text-faint);
    margin: 0 0 0.7rem;
  }
  .desc {
    margin: 0 0 0.9rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
</style>
