---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { site, sameAs } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Passe `false` na home para não repetir o nome duas vezes no <title>. */
  appendName?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  wide?: boolean;
  privateWorkspace?: boolean;
  /** JSON-LD adicional específico da página (ex.: BlogPosting, ItemList). */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** Trilha de navegação. A home é adicionada automaticamente. */
  breadcrumb?: { nome: string; href: string }[];
}

const {
  title,
  description = site.description,
  appendName = true,
  ogType = 'website',
  noindex = false,
  wide = false,
  privateWorkspace = false,
  jsonld,
  breadcrumb = [],
} = Astro.props;

const fullTitle = appendName ? `${title} | ${site.name}` : title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;

// Entidade principal do site. É isto que consolida "Jonnas Figueiredo" como
// entidade única para o Google, ligando este domínio aos perfis externos.
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.name,
    url: site.url,
    jobTitle: site.jobTitle,
    email: `mailto:${site.email}`,
    description: site.description,
    nationality: { '@type': 'Country', name: 'Brasil' },
    knowsLanguage: ['pt-BR', 'en'],
    knowsAbout: [
      'Automação de testes',
      'Quality Assurance',
      'Teste de software',
      'Selenium',
      'Appium',
      'Playwright',
      'Java',
      'TypeScript',
      'Testes de API',
      'Avaliação de modelos de linguagem',
    ],
    sameAs,
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.description,
    inLanguage: site.locale,
    publisher: { '@id': `${site.url}/#person` },
  },
];

if (breadcrumb.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ nome: 'Início', href: '/' }, ...breadcrumb].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.nome,
      item: new URL(b.href, site.url).href,
    })),
  });
}

const extras = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('jonnas-theme') === 'dark' ? 'dark' : 'light'; }
      catch { document.documentElement.dataset.theme = 'light'; }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
    {
      extras.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })}
        />
      ))
    }
  </head>
  <body data-private-workspace={privateWorkspace ? 'true' : undefined}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <div class:list={['wrap', { wide }]}>
        <slot />
      </div>
    </main>
    <Footer />
    {!privateWorkspace && <Analytics />}
  </body>
</html>
